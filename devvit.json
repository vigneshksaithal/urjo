{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "urjo-game",
  "permissions": {
    "reddit": {
      "enable": true,
      "scope": "user",
      "asUser": [
        "SUBMIT_COMMENT",
        "SUBMIT_POST",
        "SUBSCRIBE_TO_SUBREDDIT"
      ]
    },
    "redis": true
  },
  "post": {
    "dir": "dist/client",
    "entrypoints": {
      "default": {
        "entry": "preview.html",
        "height": "regular"
      },
      "game": {
        "entry": "index.html",
        "height": "tall"
      }
    }
  },
  "server": {
    "dir": "dist/server",
    "entry": "index.cjs"
  },
  "menu": {
    "items": [
      {
        "label": "Urjo Game",
        "description": "Urjo Game",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/post-create"
      }
    ]
  },
  "triggers": {
    "onAppInstall": "/internal/on-app-install",
    "onPostCreate": "/internal/on-post-create"
  },
  "scheduler": {
    "tasks": {
      "daily-puzzle": {
        "endpoint": "/internal/scheduler/daily-puzzle",
        "cron": "0 8,16,23 * * *"
      },
      "drift-check": {
        "endpoint": "/internal/scheduler/drift-check",
        "cron": "0 2 * * *"
      }
    }
  },
  "dev": {
    "subreddit": "cat543"
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build"
  }
}