{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "urjo-game",
  "permissions": {
    "reddit": {
      "enable": true,
      "scope": "user",
      "asUser": [
        "SUBMIT_COMMENT",
        "SUBMIT_POST"
      ]
    },
    "redis": true
  },
  "post": {
    "dir": "dist/client",
    "entrypoints": {
      "default": {
        "entry": "index.html",
        "height": "tall"
      }
    }
  },
  "server": {
    "dir": "dist/server",
    "entry": "index.cjs"
  },
  "menu": {
    "items": [
      {
        "label": "Urjo Game",
        "description": "Urjo Game",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/post-create"
      }
    ]
  },
  "triggers": {
    "onAppInstall": "/internal/on-app-install",
    "onPostCreate": "/internal/on-post-create",
    "onPostDelete": "/internal/on-post-delete",
    "onCommentDelete": "/internal/on-comment-delete"
  },
  "scheduler": {
    "tasks": {
      "puzzle-6x6-1400": {
        "endpoint": "/internal/scheduler/daily-puzzle",
        "cron": "0 14 * * *",
        "data": {
          "gridSize": 6,
          "slotKey": "6x6-1400"
        }
      },
      "puzzle-8x8-1600": {
        "endpoint": "/internal/scheduler/daily-puzzle",
        "cron": "0 16 * * *",
        "data": {
          "gridSize": 8,
          "slotKey": "8x8-1600"
        }
      },
      "puzzle-6x6-1800": {
        "endpoint": "/internal/scheduler/daily-puzzle",
        "cron": "0 18 * * *",
        "data": {
          "gridSize": 6,
          "slotKey": "6x6-1800"
        }
      },
      "puzzle-8x8-2000": {
        "endpoint": "/internal/scheduler/daily-puzzle",
        "cron": "0 20 * * *",
        "data": {
          "gridSize": 8,
          "slotKey": "8x8-2000"
        }
      },
      "puzzle-6x6-2200": {
        "endpoint": "/internal/scheduler/daily-puzzle",
        "cron": "0 22 * * *",
        "data": {
          "gridSize": 6,
          "slotKey": "6x6-2200"
        }
      },
      "puzzle-8x8-2330": {
        "endpoint": "/internal/scheduler/daily-puzzle",
        "cron": "30 23 * * *",
        "data": {
          "gridSize": 8,
          "slotKey": "8x8-2330"
        }
      },
      "puzzle-6x6-0100": {
        "endpoint": "/internal/scheduler/daily-puzzle",
        "cron": "0 1 * * *",
        "data": {
          "gridSize": 6,
          "slotKey": "6x6-0100"
        }
      },
      "puzzle-8x8-0230": {
        "endpoint": "/internal/scheduler/daily-puzzle",
        "cron": "30 2 * * *",
        "data": {
          "gridSize": 8,
          "slotKey": "8x8-0230"
        }
      },
      "drift-check": {
        "endpoint": "/internal/scheduler/drift-check",
        "cron": "0 2 * * *"
      }
    }
  },
  "dev": {
    "subreddit": "cat543"
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build"
  }
}
